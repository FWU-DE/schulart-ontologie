}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000832",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Das “Realschulniveu” ist ein “Bildungsgangniveau”, welches das Niveau des\n\"Realschulbildungsgangs\" beschreibt. \nEs beschreibt in welcher Tiefe und mit welchem Anspruch die Lerninhalte und Kompetenzen innerhalb dieses Bildungsgangs behandelt werden."
  }, {
    "@language" : "en",
    "@value" : "The \"Realschulniveau\" is a \"Bildungsgangniveau\" that describes the level of the “Realschulbildungsgang”.\nIt describes the depth and level of demand with which learning content and competencies are addressed within this educational track."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Realschulniveau"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000028"
  } ]
}, {
