  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has educational track level"
  }, {
    "@language" : "de",
    "@value" : "hat Bildungsgangniveau"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lehrplan/ontology/LP_0000028"
  } ]
}, {
  "@id" : "https://w3id.org/lehrplan/ontology/LP_0000834",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Das “Hauptschulniveu” ist ein “Bildungsgangniveau”, welches das Niveau des \"Hauptschulbildungsgangs\" beschreibt. \nEs beschreibt in welcher Tiefe und mit welchem Anspruch die Lerninhalte und Kompetenzen innerhalb dieses Bildungsgangs behandelt werden."
  }, {
    "@language" : "en",
    "@value" : "The \"Hauptschulniveau\" is a \"Bildungsgangniveau\" that describes the level of the “Hauptschulbildungsgang”.\nIt describes the depth and level of demand with which learning content and competencies are addressed within this educational track."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Hauptschulniveau"
  } ],
