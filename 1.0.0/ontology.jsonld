}, {
  "@id" : "https://w3id.org/schulart/",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@value" : "Types of German Schools Ontology. Version 1.0.0, https://w3id.org/schulart/"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@value" : "2026-01-06"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0001-6378-2618"
  }, {
    "@id" : "https://orcid.org/0000-0001-7192-7143"
  }, {
    "@value" : "Almut Steinlein"
  }, {
    "@value" : "Cindy Bloes"
  }, {
    "@value" : "Laura Junghanns"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "de",
    "@value" : "Die Schulart Ontologie ist ein formales Modell zur Definition und Organisation der Schularten in den deutschen Bundesländern. Sie stellt ein strukturiertes Vokabular bereit, um Schularten und deren Beziehungen zu beschreiben, zu klassifizieren und zu verknüpfen – und ermöglicht dadurch die Interoperabilität von Bildungsdaten über verschiedene Systeme und Institutionen hinweg."
  }, {
    "@language" : "en",
    "@value" : "German school type ontology"
  }, {
    "@language" : "en",
    "@value" : "The German school type ontology is a formal semantic model that defines and organizes the school types (Schularten) used across the German federal states. It provides a structured vocabulary for describing, categorizing, and interlinking school types and their relationships—allowing data interoperability across different educational datasets and systems."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by-sa/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "Schulart Ontology"
  } ],
  "http://usefulinc.com/ns/doap#repository" : [ {
    "@id" : "https://github.com/FWU-DE/schulart-ontologie"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/schulart/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.0.0"
  } ]
