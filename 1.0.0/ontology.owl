        <rdfs:comment xml:lang="de">Abschluss Niveau, das zum berufsorientierenden Abschluss befähigt.</rdfs:comment>
        <rdfs:label xml:lang="de">BOA Niveau</rdfs:label>
    </owl:Class>
    


