                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="de">Abschluss Niveau, das zur Berufsbildungsreife befähigt.</rdfs:comment>
        <rdfs:label xml:lang="de">BBR Niveau</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lehrplan/ontology/LP_0000575 -->


    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0000575">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000572"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
