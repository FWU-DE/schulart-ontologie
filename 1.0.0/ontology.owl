<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/schulart/"
     xml:base="https://w3id.org/schulart/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:doap="http://usefulinc.com/ns/doap#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ontology="https://w3id.org/lehrplan/ontology/">
    <owl:Ontology rdf:about="https://w3id.org/schulart/">
        <owl:versionIRI rdf:resource="https://w3id.org/schulart/1.0.0"/>
        <terms:bibliographicCitation>Types of German Schools Ontology. Version 1.0.0, https://w3id.org/schulart/</terms:bibliographicCitation>
        <terms:created>2026-01-06</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-6378-2618"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0001-7192-7143"/>
        <terms:creator>Almut Steinlein</terms:creator>
        <terms:creator>Cindy Bloes</terms:creator>
        <terms:creator>Laura Junghanns</terms:creator>
        <terms:description xml:lang="de">Die Schulart Ontologie ist ein formales Modell zur Definition und Organisation der Schularten in den deutschen Bundesländern. Sie stellt ein strukturiertes Vokabular bereit, um Schularten und deren Beziehungen zu beschreiben, zu klassifizieren und zu verknüpfen – und ermöglicht dadurch die Interoperabilität von Bildungsdaten über verschiedene Systeme und Institutionen hinweg.</terms:description>
        <terms:description xml:lang="en">German school type ontology</terms:description>
        <terms:description xml:lang="en">The German school type ontology is a formal semantic model that defines and organizes the school types (Schularten) used across the German federal states. It provides a structured vocabulary for describing, categorizing, and interlinking school types and their relationships—allowing data interoperability across different educational datasets and systems.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <terms:title>Schulart Ontology</terms:title>
        <doap:repository rdf:resource="https://github.com/FWU-DE/schulart-ontologie"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


