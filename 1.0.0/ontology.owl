    <!-- https://w3id.org/lehrplan/ontology/LP_0000576 -->


    <owl:Class rdf:about="https://w3id.org/lehrplan/ontology/LP_0000576">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lehrplan/ontology/LP_0000572"/>
        <rdfs:subClassOf>
            <owl:Class>
