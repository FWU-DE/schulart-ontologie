@prefix : <https://w3id.org/schulart/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/schulart/> .

<https://w3id.org/schulart/> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/schulart/1.0.0> ;
                              <http://purl.org/dc/terms/bibliographicCitation> "Types of German Schools Ontology. Version 1.0.0, https://w3id.org/schulart/" ;
                              <http://purl.org/dc/terms/created> "2026-01-06" ;
                              <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0001-6378-2618> ,
                                                                 <https://orcid.org/0000-0001-7192-7143> ,
                                                                 "Almut Steinlein" ,
                                                                 "Cindy Bloes" ,
                                                                 "Laura Junghanns" ;
                              <http://purl.org/dc/terms/description> "Die Schulart Ontologie ist ein formales Modell zur Definition und Organisation der Schularten in den deutschen Bundesländern. Sie stellt ein strukturiertes Vokabular bereit, um Schularten und deren Beziehungen zu beschreiben, zu klassifizieren und zu verknüpfen – und ermöglicht dadurch die Interoperabilität von Bildungsdaten über verschiedene Systeme und Institutionen hinweg."@de ,
                                                                     "German school type ontology"@en ,
                                                                     "The German school type ontology is a formal semantic model that defines and organizes the school types (Schularten) used across the German federal states. It provides a structured vocabulary for describing, categorizing, and interlinking school types and their relationships—allowing data interoperability across different educational datasets and systems."@en ;
                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by-sa/4.0/> ;
                              <http://purl.org/dc/terms/title> "Schulart Ontology" ;
                              <http://usefulinc.com/ns/doap#repository> <https://github.com/FWU-DE/schulart-ontologie> ;
                              owl:versionInfo "1.0.0" .

