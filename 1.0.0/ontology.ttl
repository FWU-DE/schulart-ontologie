<https://w3id.org/lehrplan/ontology/LP_0000026> rdf:type owl:ObjectProperty ;
                                                rdfs:range <https://w3id.org/lehrplan/ontology/LP_0000009> ;
                                                rdfs:label "has class level"@en ,
