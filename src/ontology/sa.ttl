                                                             owl:hasValue ontology:LP_3000048
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                    rdfs:comment "Abschluss Niveau, das zur Berufsbildungsreife befähigt."@de ;
                    rdfs:label "BBR Niveau"@de .


###  https://w3id.org/lehrplan/ontology/LP_0000575
ontology:LP_0000575 rdf:type owl:Class ;
