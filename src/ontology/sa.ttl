                                    ] ;
                    rdfs:comment "Abschluss Niveau, das zum mittlereren Schulabschluss befähigt."@de ;
                    rdfs:label "MSA Niveau"@de .


###  https://w3id.org/lehrplan/ontology/LP_0000577
ontology:LP_0000577 rdf:type owl:Class ;
                    rdfs:subClassOf ontology:LP_0000572 ,
                                    [ owl:intersectionOf ( ontology:LP_0000069
                                                           [ rdf:type owl:Restriction ;
